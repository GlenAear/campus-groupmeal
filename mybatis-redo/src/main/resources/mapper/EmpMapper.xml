<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- ⚠️ namespace 必须是 Dao 接口的完整类名（纪要原话：以实现接口方法的绑定与实现） -->
<mapper namespace="com.groupmeal.dao.EmpDao">

    <!-- type 这里必须写全类名：com.groupmeal.vo 不在 typeAliases 的扫描包里，拿不到别名 -->
    <resultMap id="empVoMap" type="com.groupmeal.vo.EmpVo">
        <!-- 主键用 id，普通列用 result；property=Java属性，column=SQL查出来的列 -->
        <id property="empNo" column="empno"/>
        <result property="empName" column="ename"/>
        <result property="money" column="salary"/>
        <result property="hDate" column="hiredate"/>
        <result property="deptNo" column="deptno"/>
    </resultMap>

    <select id="queryAllVo" resultMap="empVoMap">
        select empno, ename, salary, deptno, hiredate from emp
    </select>

    <!-- §4 的路子：不写 resultMap，改用 AS 把列**直接起成属性名**，靠自动映射按名字对上（大小写不敏感）。
         和下面 queryAllVo3 的区别：这里别名已经是驼峰 empNo/empName，开关帮不上忙也不碍事；
         queryAllVo3 的别名是下划线 emp_no，必须靠 mapUnderscoreToCamelCase=true 才认得。 -->
    <select id="queryAllVo2" resultType="com.groupmeal.vo.EmpVo">
        select empno    as empNo,
               ename    as empName,
               salary   as money,
               deptno   as deptNo,
               hiredate as hDate
        from emp
    </select>

    <!-- Step 6：列名 → 下划线别名 → 靠 mapUnderscoreToCamelCase 开关还原成驼峰属性；
         salary→money 是例外，它和属性没有任何规则可推，用的是直接别名（§4 的招） -->
    <select id="queryAllVo3" resultType="com.groupmeal.vo.EmpVo">
        select empno    as emp_no,
               ename    as emp_name,
               salary   as money,
               hiredate as h_date,
               deptno   as dept_no
        from emp
    </select>

    <!-- 接口里没有叫 querySalaryGt 的方法，但 MyBatis 照样注册它 -->
    <select id="querySalaryGt" resultType="Emp">
        select empno,ename,salary,deptno,hiredate from emp where salary &gt; #{minSal}
    </select>

    <select id="getCount" resultType="int">
        select count(*) from emp
    </select>

    <!-- resultType="Emp" 能这么写，是因为 Step 4 配了 typeAliases 包扫描 -->
    <select id="queryAll" resultType="Emp">
        select empno, ename, salary, deptno, hiredate from emp
    </select>

    <select id="queryByEmpno" parameterType="int" resultType="Emp">
        select empno, ename, salary, deptno, hiredate
        from emp where empno = #{empno}
    </select>

    <!-- useGeneratedKeys/keyProperty：插入后把自增主键回填到 emp.empno（PDF 没写，项目里必用） -->
    <insert id="saveEmp" parameterType="Emp" useGeneratedKeys="true" keyProperty="empno">
        insert into emp(ename, salary, deptno, hiredate)
        values(#{ename}, #{salary}, #{deptno}, #{hiredate})
    </insert>

    <update id="updateEmp" parameterType="Emp">
        update emp
        set ename = #{ename}, salary = #{salary}, deptno = #{deptno}, hiredate = #{hiredate}
        where empno = #{empno}
    </update>

    <delete id="deleteByEmpno" parameterType="int">
        delete from emp where empno = #{empno}
    </delete>


</mapper>
