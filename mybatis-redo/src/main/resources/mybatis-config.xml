<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <!-- ⓪ 外部属性文件：数据库四要素写在 jdbc.properties 里，那份文件已进 .gitignore，绝不提交。
         DTD 规定 <properties> 必须放在 <settings> 之前，位置写错会直接报构建异常。
         真实项目里这也叫"配置外置"——Spring Boot 的 application.yml / @ConfigurationProperties 是同一件事。 -->
    <properties resource="jdbc.properties"/>

    <!-- ① 全局设置：打开 SQL 日志（PDF p5「日志配置」）＋ 下划线转驼峰 -->
    <settings>
        <setting name="logImpl" value="STDOUT_LOGGING"/>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <!-- ② 类型别名：扫整个包，之后映射文件里可直接写 Emp 而不必写全类名（纪要「配置别名简化」） -->
    <typeAliases>
        <package name="com.groupmeal.entity"/>
    </typeAliases>

    <!-- ③ 环境：数据库四要素（驱动、URL、用户名、密码）＝所有 JDBC 封装框架的通用要求（纪要原话） -->
    <environments default="devA">
        <environment id="devA">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <!-- 四个值全部来自 jdbc.properties：源码/配置里不出现任何真实账号密码 -->
                <property name="driver"   value="${driver}"/>
                <property name="url"      value="${url}"/>
                <property name="username" value="${user}"/>
                <property name="password" value="${password}"/>
            </dataSource>
        </environment>
    </environments>

    <!-- ④ 注册映射文件（纪要：新增 mapper 必须在这里注册，否则容器不认识它） -->
    <mappers>
        <mapper resource="mapper/EmpMapper.xml"/>
    </mappers>

</configuration>
